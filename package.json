{
  "name": "@xthooh/pi-ssh",
  "version": "1.3.2",
  "description": "SSH client extension for the pi coding agent. Run commands, transfer files over SFTP, and set up key-based login on remote hosts.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "ssh",
    "sftp",
    "remote",
    "ssh2"
  ],
  "author": "xthooh (fork of Patrick Weppelmann's pi-ssh)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/x-thooh/pi-ssh.git"
  },
  "bugs": {
    "url": "https://github.com/x-thooh/pi-ssh/issues"
  },
  "scripts": {
    "build": "echo 'No build step defined'",
    "test": "node --experimental-test-module-mocks --experimental-test-coverage --test 'tests/**/*.test.ts'",
    "test:watch": "node --experimental-test-module-mocks --test --watch 'tests/**/*.test.ts'",
    "test:coverage": "node --experimental-test-module-mocks --experimental-test-coverage --test 'tests/**/*.test.ts'"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@semantic-release/git": "^10.0.0",
    "@types/ssh2": "^1.15.0",
    "semantic-release": "^25.0.0",
    "typebox": "^1.3.25",
    "yaml": "^2.9.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
